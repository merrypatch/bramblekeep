# Rust
/target
**/*.rs.bk

# SQLite (local data). Any local database, whatever it is named: a throwaway
# instance for testing (`DATABASE_URL=sqlite://scratch.db cargo run`) must never
# reach a commit.
*.db
*.db-shm
*.db-wal
*.db.bak*
# Rollback copies a restore leaves beside the database (`bramblekeep restore`,
# and the interface path). Same rule as any local database: never a commit.
*.db.before-restore-*
# Archive waiting for the restart that applies it.
restore-pending.zip
/files
# Upload directory of a throwaway instance (`FILES_DIR=files-scratch cargo run`):
# its blobs are test content, never repository content.
files-scratch/
files-*/

# Front
web/node_modules
web/dist/*
!web/dist/.gitkeep
web/*.tsbuildinfo

# Generated ts-rs bindings
/bindings

# Miscellaneous
.env
.DS_Store

# Local e2e databases
bramblekeep_e2e.db*
