# Rust
/target
**/*.rs.bk

# SQLite (local data). Any local database, whatever it is named: a throwaway
# instance for testing (`DATABASE_URL=sqlite://scratch.db cargo run`) must never
# reach a commit.
*.db
*.db-shm
*.db-wal
*.db.bak*
/files

# Front
web/node_modules
web/dist/*
!web/dist/.gitkeep
web/*.tsbuildinfo

# Generated ts-rs bindings
/bindings

# Miscellaneous
.env
.DS_Store

# Local e2e databases
bramblekeep_e2e.db*
